# --- Shopify (required) -------------------------------------------------------------
SHOPIFY_DOMAIN=staging-purdy-global.myshopify.com
# Either a token (existing legacy custom app) ...
SHOPIFY_ACCESS_TOKEN=
# ... or a Dev Dashboard app (client credentials grant; token refreshed every 24 h)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Webhook signing secret. Defaults to SHOPIFY_CLIENT_SECRET (webhooks registered by the app).
# For a legacy custom app use its "API secret key".
SHOPIFY_WEBHOOK_SECRET=

# --- Database (required in production) -----------------------------------------------
# Turso (free plan): turso db show <name> --url  and  turso db tokens create <name>
# Leave both empty locally: the app then uses a file under DATA_DIR.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- App (required) -----------------------------------------------------------------
ADMIN_PASSWORD=admin
SESSION_SECRET=long-random-string
# Public https URL of this app (used to register the orders/create webhook)
PUBLIC_URL=https://golden-tray.example.com

# --- Optional -----------------------------------------------------------------------
PORT=3100
# Local database folder (only used when DATABASE_URL is empty)
DATA_DIR=./data
# How long heavy dashboard reads are reused (ms). Default 8000 with Turso, 0 with a local file.
# READ_CACHE_MS=8000
# Orders processed at the same time (default 6, max 20)
# WORKER_CONCURRENCY=6
# Bearer token for scripts (curl) instead of the dashboard login
ADMIN_TOKEN=
# Seed the tray on the very first boot only (after that: dashboard → Settings)
GOLDEN_TRAY_SKU=
GOLDEN_TRAY_VARIANT_ID=
# Local testing only: talk to scripts/fake-shopify.js instead of Shopify
# SHOPIFY_BASE_URL=http://127.0.0.1:4200
